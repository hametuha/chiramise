{
  "name": "chiramise",
  "version": "1.0.1",
  "description": "Chiramise's asset build",
  "scripts": {
    "lint": "eslint src/js",
    "package": "terser src/js/toc-helper.js --compress --mangle --source-map \"url='map/toc-helper.js.map'\" --output assets/js/toc-helper.js && mkdir -p assets/js/map && mv assets/js/toc-helper.js.map assets/js/map/",
    "start": "npm run package"
  },
  "author": "Hametuha inc.",
  "license": "GPL-2.0",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "terser": "^5.36.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hametuha/chiramise.git"
  },
  "keywords": [
    "sns",
    "wordpress"
  ],
  "bugs": {
    "url": "https://github.com/hametuha/chiramise/issues"
  },
  "homepage": "https://github.com/hametuha/chiramise#readme"
}
